@model EsCheckWeb.Models.EsCheckViewModel

@{
    ViewData["Title"] = "Status Klastra";
}

@section Styles {
    <style>
        .editor-container {
            border: 1px solid var(--border);
            border-radius: 8px;
            overflow: hidden;
            background: #000;
        }
        .nav-tabs .nav-link {
            transition: all 0.2s;
        }
    </style>
}

<div class="container-fluid">
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h1 class="mb-1">Eksplorator <span class="text-gradient">Klastrów</span></h1>
            <p class="text-muted mb-0">Podgląd statusu i struktury indeksów</p>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <div class="d-inline-block text-start p-3 rounded-pill bg-dark border border-secondary shadow-sm">
                <div class="d-flex align-items-center">
                    <div class="me-3">
                        <div class="text-accent fw-bold x-small text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.05em;">Aktywny Serwer</div>
                        <div class="h6 mb-0 fw-bold">@Model.ActiveServerName</div>
                    </div>
                    <div class="border-start border-secondary ps-3">
                        <code class="text-muted small">@Model.ActiveServerUrl</code>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (!Model.Success)
    {
        <div class="alert badge-error border-0 p-4 shadow-lg rounded-4">
            <div class="d-flex align-items-start">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="width:24px; margin-right:16px; margin-top:2px;"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                <div>
                    <h4 class="h5 fw-bold">Błąd połączenia</h4>
                    <p class="mb-3 opacity-75">@Model.Error</p>
                    <a href="/Servers" class="btn btn-outline-danger btn-sm rounded-pill px-4">Zmień konfigurację serwera</a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Left Column: Stats & Selection -->
            <div class="col-xl-4 col-lg-5">
                <div class="d-flex flex-column gap-4">
                    <!-- Cluster Info Card -->
                    <div class="card-glass shadow-lg">
                        <h3 class="h5 mb-4 text-accent d-flex align-items-center">
                            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="width:18px; margin-right:10px;"><path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            Informacje o klastrze
                        </h3>
                        <div class="row g-3">
                            <div class="col-12 p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary">
                                <label class="mb-1">Cluster Name</label>
                                <div class="h6 mb-0 fw-bold text-white">@Model.ClusterName</div>
                            </div>
                            <div class="col-12 p-3 rounded-3 bg-dark bg-opacity-50 border border-secondary">
                                <label class="mb-1">Version</label>
                                <div class="h6 mb-0 fw-bold text-white">@Model.Version</div>
                            </div>
                        </div>
                    </div>

                    <!-- Index Selector Card -->
                    <div class="card-glass shadow-lg">
                        <h3 class="h5 mb-4 text-accent">Wybierz Indeks</h3>
                        <form method="get" class="row g-3">
                            <div class="col-12">
                                <select name="indexName" class="form-select form-select-lg mb-3">
                                    <option value="">-- wybierz indeks z listy --</option>
                                    @foreach (var index in Model.Indices)
                                    {
                                        <option value="@index" selected="@(index == Model.SelectedIndex)">@index</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn-premium w-100 py-3">Sprawdź Indeks</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Right Column: Details -->
            <div class="col-xl-8 col-lg-7">
                @if (!string.IsNullOrWhiteSpace(Model.SelectedIndex))
                {
                    <div class="card-glass shadow-lg border-accent border-opacity-10 h-100 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h2 class="h4 mb-0 d-flex align-items-center">
                                <span class="text-accent me-2">Szczegóły:</span> 
                                <span class="fw-extrabold">@Model.SelectedIndex</span>
                            </h2>
                            <span class="badge-status badge-success">READY</span>
                        </div>

                        <ul class="nav nav-tabs border-0 gap-2 mb-4 p-1 bg-dark rounded-pill d-inline-flex" id="detailsTab" role="tablist">
                            <li class="nav-item">
                                <button class="nav-link active rounded-pill px-4 py-2 border-0" id="mapping-tab" data-bs-toggle="tab" data-bs-target="#mapping" type="button">Mapping</button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link rounded-pill px-4 py-2 border-0" id="sample-tab" data-bs-toggle="tab" data-bs-target="#sample" type="button">Przykładowy Dokument</button>
                            </li>
                        </ul>

                        <div class="tab-content flex-grow-1">
                            <div class="tab-pane fade show active h-100" id="mapping">
                                <div id="monacoMapping" class="editor-container shadow-sm h-100" style="min-height: 600px;"></div>
                                <div id="rawMapping" style="display:none;">@Model.MappingJson</div>
                            </div>
                            <div class="tab-pane fade h-100" id="sample">
                                <div id="monacoSample" class="editor-container shadow-sm h-100" style="min-height: 600px;"></div>
                                <div id="rawSample" style="display:none;">@Model.SampleDocumentJson</div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card-glass h-100 d-flex flex-column align-items-center justify-content-center text-center py-5 opacity-50">
                        <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" style="width:64px; margin-bottom:24px;" class="text-muted"><path d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"></path></svg>
                        <h3 class="h5">Wybierz indeks, aby zobaczyć szczegóły</h3>
                        <p class="text-muted small">Mapping i dane pojawią się tutaj po wybraniu pozycji z listy</p>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.44.0/min/vs/loader.min.js"></script>
    <script>
        require.config({ paths: { vs: 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.44.0/min/vs' } });

        require(['vs/editor/editor.main'], function () {
            const commonConfig = {
                language: 'json',
                theme: 'vs-dark',
                readOnly: true,
                automaticLayout: true,
                minimap: { enabled: true },
                fontSize: 13,
                scrollBeyondLastLine: false,
                padding: { top: 16, bottom: 16 },
                lineNumbers: 'on',
                glyphMargin: false,
                folding: true,
                lineDecorationsWidth: 10,
                lineNumbersMinChars: 3
            };

            const mappingRaw = document.getElementById('rawMapping');
            if (mappingRaw) {
                monaco.editor.create(document.getElementById('monacoMapping'), {
                    ...commonConfig,
                    value: mappingRaw.innerText
                });
            }

            const sampleRaw = document.getElementById('rawSample');
            if (sampleRaw) {
                monaco.editor.create(document.getElementById('monacoSample'), {
                    ...commonConfig,
                    value: sampleRaw.innerText
                });
            }
            
            // Fix layout on tab switch
            document.querySelectorAll('button[data-bs-toggle="tab"]').forEach(tabEl => {
                tabEl.addEventListener('shown.bs.tab', () => {
                    window.dispatchEvent(new Event('resize'));
                });
            });
        });
    </script>
}
